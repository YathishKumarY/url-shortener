# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Any PostgreSQL: Prisma Postgres, Neon (serverless driver is picked
# automatically for *.neon.tech hosts), Supabase, RDS, Docker, a local install...
DATABASE_URL=
# Hosts with a connection pooler give two strings for one database. The app
# uses the pooled one, Prisma CLI commands (db push) the direct one:
# - Vercel's Prisma Postgres integration: DATABASE_URL is direct
#   (db.prisma.io) and it adds DATABASE_URL_POOLED (pooled.db.prisma.io).
# - Manual setup: put the pooled string in DATABASE_URL and the direct one
#   in DIRECT_URL.
DATABASE_URL_POOLED=
DIRECT_URL=
# Force a driver instead of auto-detecting: "neon" or "pg".
DATABASE_DRIVER=
# Connections per app instance for the pg driver (default 10, or 2 on Vercel).
DATABASE_POOL_SIZE=

# ---------------------------------------------------------------------------
# App + auth (required)
# ---------------------------------------------------------------------------
# Public origin of the deployment. Used for short URLs and QR codes, so it must
# be the address visitors reach - not an internal hostname.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
AUTH_SECRET=  # Generate with: npx auth secret
# Set to true when running behind a reverse proxy you trust (Docker, Nginx).
AUTH_TRUST_HOST=

# Display name used in titles, emails and the API.
NEXT_PUBLIC_SITE_NAME=Linkly

# OAuth providers are optional; buttons only appear when both values are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Generic OpenID Connect SSO (Okta, Microsoft Entra ID, Keycloak, Authentik...).
# Callback URL to register: <AUTH_URL>/api/auth/callback/oidc
AUTH_OIDC_ISSUER=
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=
AUTH_OIDC_NAME=SSO

# Comma-separated emails promoted to admin when they sign in.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Redis (optional)
# ---------------------------------------------------------------------------
# Upstash REST credentials. Without them the cache and rate limiters use
# process memory, which is fine for a single instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Email (required in production)
# ---------------------------------------------------------------------------
# New email/password accounts must open a verification link before they can
# sign in, and password resets are emailed too. With no provider configured,
# emails are printed to the server console instead - fine for local work (copy
# the link from the terminal), not for production.
#
# Option 1, SMTP: any mailbox provider. Gmail works without owning a domain:
# turn on 2-Step Verification, create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Option 2, Resend: needs a domain you own to email anyone but yourself.
RESEND_API_KEY=
# Sender. Defaults to "Linkly <SMTP_USER>" with SMTP.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Access control
# ---------------------------------------------------------------------------
# Invite-only instance: existing users can sign in, nobody can sign up.
DISABLE_REGISTRATION=false
# Require an account or API key to create links.
DISABLE_ANONYMOUS_LINKS=false
# Only allow destinations on these domains (and subdomains), comma-separated.
# Example: wikipedia.org,wikimedia.org - like the Wikimedia shortener.
ALLOWED_DOMAINS=

# ---------------------------------------------------------------------------
# Links
# ---------------------------------------------------------------------------
# Length of generated short codes (4-16, default 7).
SHORT_CODE_LENGTH=7
# Maximum links per bulk create / CSV import request (default 100).
BULK_LINK_LIMIT=100
# Protocol for custom-domain short links. Only change for local testing.
CUSTOM_DOMAIN_PROTOCOL=https

# ---------------------------------------------------------------------------
# Analytics and privacy
# ---------------------------------------------------------------------------
# Secret salt for hashing visitor IPs. Without it the hashes can be reversed by
# brute force. Generate with: openssl rand -hex 32
IP_HASH_SALT=
# Requests per minute per IP. Raise RATE_LIMIT_REDIRECTS if many visitors share
# one address (corporate NAT, campus networks).
RATE_LIMIT_REDIRECTS=600
RATE_LIMIT_ANON_CREATE=10
# Number of trusted proxies in front of the app, counted from the client.
# Controls which x-forwarded-for entry is used for rate limiting. Default 1.
TRUSTED_PROXY_COUNT=1
# Country/city come from Vercel or Cloudflare headers. On other hosts you can
# opt in to an IP lookup service: "ip-api" (free, HTTP) or "ipinfo" (needs
# IPINFO_TOKEN). Default "none" - visitor IPs are never sent to third parties.
GEOLOCATION_PROVIDER=none
IPINFO_TOKEN=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Screen destinations with Google Safe Browsing when links are saved.
GOOGLE_SAFE_BROWSING_API_KEY=
# Let server-side fetches (page metadata, webhooks) reach private/loopback
# addresses. Keep false in production: it would allow SSRF.
ALLOW_PRIVATE_NETWORK_FETCH=false

# ---------------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------------
# Comma-separated extra dev origins allowed by Next (optional)
ALLOWED_DEV_ORIGINS=
# Build a standalone server bundle (used by the Dockerfile).
STANDALONE=

# Copy to .env.docker and edit. Never commit .env.docker.
#
# Compose reads these from your shell or a root-level .env (NOT from
# .env.docker) for build args and the Postgres container: NEXT_PUBLIC_APP_URL,
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB, NPM_CONFIG_REGISTRY,
# NPMRC_FILE. Keep them consistent with the values below.

# ---- Database ----
# Points at the compose `db` service. docker-compose.yml builds this URL from
# POSTGRES_* itself, so this line only matters if you run the app elsewhere.
DATABASE_URL=postgresql://linkly:linkly@db:5432/linkly
# CHANGE THE PASSWORD before first start; the volume keeps the original one.
POSTGRES_USER=linkly
POSTGRES_PASSWORD=linkly
POSTGRES_DB=linkly
# Max connections in the app pool (optional).
DATABASE_POOL_SIZE=10

# ---- Core (required) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public origin visitors use for short URLs. Inlined at BUILD time: also export
# it in your shell or root .env so compose passes it as a build arg, and
# rebuild if it changes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Required behind a reverse proxy (compose already sets it to true).
AUTH_TRUST_HOST=true
# Secret salt for hashing visitor IPs. Generate with: openssl rand -hex 32
IP_HASH_SALT=

# Number of trusted proxies in front of the app, counted from the client.
TRUSTED_PROXY_COUNT=1

# ---- OAuth sign-in (optional) ----
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Email (optional) ----
# Without a Resend key, emails are logged to the container output instead.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# ---- Access control (optional) ----
# Comma-separated emails that get admin access.
ADMIN_EMAILS=
# true to stop new sign-ups.
DISABLE_REGISTRATION=
# true to require sign-in to create links.
DISABLE_ANONYMOUS_LINKS=
# Comma-separated domains users may shorten (empty = any).
ALLOWED_DOMAINS=

# ---- Integrations (optional) ----
# Geolocation provider for click analytics (see the app docs for valid values).
GEOLOCATION_PROVIDER=
GOOGLE_SAFE_BROWSING_API_KEY=

# ---- Redis (optional) ----
# Upstash REST endpoint. Leave empty to use in-memory cache and rate limiting
# (fine for a single instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
